# Copy to .env for local runs. Used only when the matching SSM parameter
# (/docubrain/...) is missing or SSM can't be reached.
KB_ID=
GUARDRAIL_ID=
GUARDRAIL_VERSION=1
MODEL_ARN=arn:aws:bedrock:ap-southeast-2:<account-id>:inference-profile/apac.amazon.nova-lite-v1:0

# Optional
AWS_REGION=ap-southeast-2
PARAM_PREFIX=/docubrain
CORS_ORIGINS=*
LOG_LEVEL=INFO
