# Copy to .env for local runs. Used only when the matching SSM parameter
# (/docubrain/...) is missing or SSM can't be reached.
KB_ID=
GUARDRAIL_ID=
GUARDRAIL_VERSION=1
MODEL_ARN=arn:aws:bedrock:ap-southeast-2:<account-id>:inference-profile/apac.amazon.nova-lite-v1:0

# Model that writes the answers: "bedrock" (default, needs Bedrock model quota)
# or "ollama" (local open-source model; the knowledge base and guardrail still run on AWS)
MODEL_PROVIDER=bedrock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_MAX_CHUNKS=3
OLLAMA_TIMEOUT_SECONDS=180

# Optional
AWS_REGION=ap-southeast-2
PARAM_PREFIX=/docubrain
CORS_ORIGINS=*
LOG_LEVEL=INFO
